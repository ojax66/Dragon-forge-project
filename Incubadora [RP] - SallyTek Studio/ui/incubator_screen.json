{
  "namespace": "incubator_ui",

  // Posicoes medidas no mock-up de referencia (284x266 = uma tela de 176x166
  // renderizada em 1.611x). Ver tools/gen_ui_textures.py.
  "title_label": {
    "type": "label",
    "offset": [ 58, 6 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "color": "$title_text_color",
    "layer": 4
  },

  "inventory_label": {
    "type": "label",
    "offset": [ -11, 72 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "text": "container.inventory",
    "color": "$title_text_color",
    "layer": 4
  },

  // Os 5 slots do container da entidade, espalhados por cima da arte.
  // O deslocamento de cada um ja desconta o passo de 18px da grade:
  //   offset_x = x_desejado - (indice * 18)
  // Posicoes na tela: tanque 7,16 | balde 31,57 | entrada 74,36 |
  //                   setinha 95,33 | saida 124,33
  // Indices: 0 tanque | 1 balde | 2 entrada | 3 setinha | 4 saida
  //          — mesma ordem usada em scripts/main.js.
  "slots_grid": {
    "type": "grid",
    "size": [ 90, 18 ],
    "offset": [ 0, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [ 5, 1 ],
    "collection_name": "container_items",
    "grid_item_template": "incubator_common.slot",
    "controls": [
      {
        "fuel_gauge": {
          "type": "panel",
          "grid_position": [ 0, 0 ],
          "controls": [
            { "slot@incubator_common.gauge_fuel": { "offset": [ 7, 16 ], "layer": 0 } }
          ]
        }
      },
      {
        "fuel_slot": {
          "type": "panel",
          "grid_position": [ 1, 0 ],
          "controls": [
            { "slot@incubator_common.slot": { "offset": [ 13, 57 ], "layer": 0 } }
          ]
        }
      },
      {
        "input_slot": {
          "type": "panel",
          "grid_position": [ 2, 0 ],
          "controls": [
            { "slot@incubator_common.slot": { "offset": [ 38, 36 ], "layer": 0 } }
          ]
        }
      },
      {
        "progress_gauge": {
          "type": "panel",
          "grid_position": [ 3, 0 ],
          "controls": [
            { "slot@incubator_common.gauge_arrow": { "offset": [ 41, 33 ], "layer": 0 } }
          ]
        }
      },
      {
        "output_slot": {
          "type": "panel",
          "grid_position": [ 4, 0 ],
          "controls": [
            { "slot@incubator_common.slot_big": { "offset": [ 52, 33 ], "layer": 0 } }
          ]
        }
      }
    ]
  },

  "top_half": {
    "type": "panel",
    "size": [ 176, 166 ],
    "offset": [ 0, 0 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      { "title@incubator_ui.title_label": {} },
      { "inventory@incubator_ui.inventory_label": {} },
      { "slots@incubator_ui.slots_grid": {} }
    ]
  }
}
