{
  "namespace": "incubator_ui",

  "title_label": {
    "type": "label",
    "offset": [ 10, 7 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "$container_title",
    "color": "$title_text_color",
    "layer": 4
  },

  "inventory_label": {
    "type": "label",
    "offset": [ 10, 104 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "text": "container.inventory",
    "color": "$title_text_color",
    "layer": 4
  },

  // Os 5 slots do container da entidade, espalhados por cima da arte.
  // O deslocamento de cada um ja desconta o passo de 18px da grade:
  //   offset_x = x_desejado - (indice * 18)
  // Indices: 0 barra de lava | 1 balde | 2 entrada | 3 barra de progresso |
  //          4 saida  — mesma ordem usada em scripts/main.js.
  "slots_grid": {
    "type": "grid",
    "size": [ 90, 18 ],
    "offset": [ 0, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [ 5, 1 ],
    "collection_name": "container_items",
    "grid_item_template": "incubator_common.slot",
    "controls": [
      {
        "fuel_gauge": {
          "type": "panel",
          "grid_position": [ 0, 0 ],
          "controls": [
            { "slot@incubator_common.gauge_fuel": { "offset": [ 14, 26 ], "layer": 0 } }
          ]
        }
      },
      {
        "fuel_slot": {
          "type": "panel",
          "grid_position": [ 1, 0 ],
          "controls": [
            { "slot@incubator_common.slot": { "offset": [ 24, 48 ], "layer": 0 } }
          ]
        }
      },
      {
        "input_slot": {
          "type": "panel",
          "grid_position": [ 2, 0 ],
          "controls": [
            { "slot@incubator_common.slot": { "offset": [ 42, 28 ], "layer": 0 } }
          ]
        }
      },
      {
        "progress_gauge": {
          "type": "panel",
          "grid_position": [ 3, 0 ],
          "controls": [
            { "slot@incubator_common.gauge_arrow": { "offset": [ 50, 30 ], "layer": 0 } }
          ]
        }
      },
      {
        "output_slot": {
          "type": "panel",
          "grid_position": [ 4, 0 ],
          "controls": [
            { "slot@incubator_common.slot": { "offset": [ 78, 30 ], "layer": 0 } }
          ]
        }
      }
    ]
  },

  "top_half": {
    "type": "panel",
    "size": [ 200, 200 ],
    "offset": [ 0, 0 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      { "title@incubator_ui.title_label": {} },
      { "inventory@incubator_ui.inventory_label": {} },
      { "slots@incubator_ui.slots_grid": {} }
    ]
  }
}
