{
  "namespace": "chest",

  // Expoe o titulo do container como variavel, pra dar pra comparar em
  // "requires" la embaixo.
  "chest_label": {
    "$new_container_title|default": "$container_title",
    "text": "$new_container_title"
  },

  "incubator_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 14 } },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": [ 176, 166 ],
          "controls": [
            {
              "bg": {
                "type": "image",
                "texture": "textures/ui/incubator_gui"
              }
            },
            {
              "screen@common.close_button": {
                "offset": [ -6, 4 ],
                "anchor_from": "top_right",
                "anchor_to": "top_right"
              }
            },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "panel_top_half@incubator_ui.top_half": {} },
                  { "inventory_panel_bottom_half@common.inventory_panel_bottom_half": {
                      "$background_images": "incubator_common.cell_image"
                  } },
                  { "hotbar_grid@common.hotbar_grid_template": {
                      "$background_images": "incubator_common.cell_image"
                  } },
                  { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
                ]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  },

  // Painel da Incubadora de gelo. E o de cima com dois arquivos trocados:
  // o fundo e a metade de cima (que usa as celulas de gelo). Esta duplicado
  // de proposito - o painel de lava e o unico caminho comprovado ate a tela
  // funcionar, e nao vale a pena transformar ele em template agora.
  "ice_incubator_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 14 } },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": [ 176, 166 ],
          "controls": [
            {
              "bg": {
                "type": "image",
                "texture": "textures/ui/ice_incubator_gui"
              }
            },
            {
              "screen@common.close_button": {
                "offset": [ -6, 4 ],
                "anchor_from": "top_right",
                "anchor_to": "top_right"
              }
            },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "panel_top_half@ice_incubator_ui.top_half": {} },
                  { "inventory_panel_bottom_half@common.inventory_panel_bottom_half": {
                      "$background_images": "incubator_common.cell_image_ice"
                  } },
                  { "hotbar_grid@common.hotbar_grid_template": {
                      "$background_images": "incubator_common.cell_image_ice"
                  } },
                  { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
                ]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  },

  // Troca o conteudo da tela de bau pequeno quando o container aberto e a
  // Incubadora. Qualquer outro bau continua com a tela normal.
  //
  // A porteira compara o apelido da entidade do container, que e a unica
  // forma comprovada de reconhecer a Incubadora aqui. Ja tentei tirar o
  // apelido pra sumir com o nome flutuante do bloco; sem ele o titulo do
  // container deixa de ser uma string minha e a tela volta a ser bau comum.
  // O nome sumiu do alto da tela (nao existe rotulo de titulo em
  // ui/incubator_screen.json), mas o apelido fica.
  "small_chest_screen": {
    "$new_container_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'sallytek.incubator.block')",
          "$screen_content": "chest.incubator_panel",
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'sallytek.incubator.block' and $pocket_screen)",
          "$screen_content": "chest.incubator_panel",
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'sallytek.ice_incubator.block')",
          "$screen_content": "chest.ice_incubator_panel",
          "$screen_bg_content": "common.screen_background"
        }
      },
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": {
          "requires": "($new_container_title = 'sallytek.ice_incubator.block' and $pocket_screen)",
          "$screen_content": "chest.ice_incubator_panel",
          "$screen_bg_content": "common.screen_background"
        }
      }
    ]
  }
}
