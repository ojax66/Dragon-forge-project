{
  "namespace": "incubator_common",

  // Celula vermelha da Incubadora. Entra no lugar de common.cell_image_panel
  // via $background_images, entao ela e desenhada pelo proprio JSON UI em cima
  // de cada slot de verdade - inclusive nos slots do inventario do jogador.
  // Nine-slice de 1px: a mesma textura serve pro slot de 18x18, pra saida de
  // 26x26 e pro tanque de 18x61.
  "cell_image": {
    "type": "image",
    "texture": "textures/ui/incubator_cell",
    "size": "$cell_image_size"
  },

  // Slot de container de verdade: arrastar, clicar e shift-clicar funcionam.
  "slot@common.container_item": {
    "ignored": false,
    "$item_collection_name": "container_items",
    "$background_images": "incubator_common.cell_image",
    "size": [ 18, 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // Saida: celula maior, como a da fornalha.
  "slot_big@incubator_common.slot": {
    "size": [ 26, 26 ],
    "$cell_image_size": [ 26, 26 ],
    "$item_renderer_panel_size": [ 26, 26 ],
    "$item_renderer_size": [ 16, 16 ]
  },

  // Base dos dois medidores. O item dentro deles e um item-display trocado
  // pelo script; $button_ref vira painel vazio pra nao existir botao, e sem
  // botao o jogador nao consegue tirar a barra do lugar.
  "gauge@incubator_common.slot": {
    "$button_ref": "common.empty_panel",
    "$stack_count_required": false,
    "$durability_bar_required": false,
    "$storage_bar_required": false
  },

  // Tanque de lava. A textura da barra e 72x266, mas icone de item no Bedrock
  // e sempre quadrado, entao ela e gravada centralizada num canvas de 266x266
  // (tools/install_gauge_textures.py faz isso). Desenhando o item a 59x59, a
  // barra dentro dele sai com 59 * 72/266 = 16 de largura por 59 de altura -
  // exatamente a medida do mock-up. O que sobra do quadrado e transparente.
  "gauge_fuel@incubator_common.gauge": {
    "size": [ 18, 61 ],
    "$cell_image_size": [ 18, 61 ],
    "$item_renderer_panel_size": [ 59, 59 ],
    "$item_renderer_size": [ 59, 59 ]
  },

  // Setinha de progresso: sem celula atras, porque a textura dela ja tem
  // contorno proprio. Textura de origem 32x32.
  "gauge_arrow@incubator_common.gauge": {
    "$background_images": "common.empty_panel",
    "size": [ 26, 26 ],
    "$cell_image_size": [ 26, 26 ],
    "$item_renderer_panel_size": [ 26, 26 ],
    "$item_renderer_size": [ 26, 26 ]
  },

  // ------------------------------------------------------------------ gelo
  // Os controles abaixo sao os de cima com outra celula. Nada aqui mexe nos
  // de lava: a Incubadora de lava continua com os arquivos dela intocados.

  "cell_image_ice": {
    "type": "image",
    "texture": "textures/ui/ice_incubator_cell",
    "size": "$cell_image_size"
  },

  "slot_ice@incubator_common.slot": {
    "$background_images": "incubator_common.cell_image_ice"
  },

  "slot_big_ice@incubator_common.slot_big": {
    "$background_images": "incubator_common.cell_image_ice"
  },

  "gauge_fuel_ice@incubator_common.gauge_fuel": {
    "$background_images": "incubator_common.cell_image_ice"
  },

  // A setinha nao tem celula atras nem na de lava nem na de gelo.
  "gauge_arrow_ice@incubator_common.gauge_arrow": {}
}
